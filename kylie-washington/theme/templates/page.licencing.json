{
  "sections": {
    "main": {
      "type": "main-page",
      "settings": {
        "color_scheme": "scheme-1",
        "show_title": true,
        "page_width": "sm"
      }
    },
    "form": {
      "type": "contact",
      "settings": {
        "color_scheme": "scheme-1",
        "separate_section_with_border": false,
        "title": "Licencing enquiry",
        "heading_style": "h3",
        "content": "<p>Tell us about your project and the artwork you are interested in.</p>"
      },
      "blocks": {
        "field-1": {
          "type": "text",
          "settings": {
            "title": "Company",
            "required": false,
            "use_long_text": false
          }
        },
        "field-2": {
          "type": "text",
          "settings": {
            "title": "Artwork(s) of interest",
            "required": false,
            "use_long_text": false
          }
        },
        "field-3": {
          "type": "dropdown",
          "settings": {
            "title": "Intended use",
            "values": "Interiors / hospitality, Print and publishing, Homewares and products, Digital, Other"
          }
        },
        "field-4": {
          "type": "text",
          "settings": {
            "title": "Territory and duration",
            "required": false,
            "use_long_text": false
          }
        }
      },
      "block_order": [
        "field-1",
        "field-2",
        "field-3",
        "field-4"
      ]
    }
  },
  "order": [
    "main",
    "form"
  ]
}
